# Copy to .env.local (local) and add the same keys in Vercel > Project > Settings > Environment Variables.

# Your live domain, without trailing slash
NEXT_PUBLIC_SITE_URL=https://womensmeetupsamsterdam.nl

# Supabase (Project settings > API). The service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mollie (Dashboard > Developers > API keys). Start with test_..., switch to live_... later.
MOLLIE_API_KEY=
